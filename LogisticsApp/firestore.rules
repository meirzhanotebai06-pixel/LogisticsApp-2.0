rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isSignedIn() && userDoc().userType == 'admin';
    }

    function isDriver() {
      return isSignedIn() && userDoc().userType == 'driver';
    }

    function hasVerifiedDoc(docs, key) {
      return key in docs &&
             docs[key] is map &&
             docs[key].isVerified == true;
    }

    function isVerifiedDriver() {
      return isDriver() &&
             'vehicleInfo' in userDoc() &&
             userDoc().vehicleInfo is map &&
             'documents' in userDoc().vehicleInfo &&
             userDoc().vehicleInfo.documents is map &&
             hasVerifiedDoc(userDoc().vehicleInfo.documents, 'insurance') &&
             hasVerifiedDoc(userDoc().vehicleInfo.documents, 'driverLicense') &&
             hasVerifiedDoc(userDoc().vehicleInfo.documents, 'vehicleRegistration') &&
             hasVerifiedDoc(userDoc().vehicleInfo.documents, 'technicalInspection');
    }

    function docIsUnverifiedOrUnchanged(reqDocs, resDocs, key) {
      return !(key in reqDocs) ||
             (reqDocs[key] is map &&
              reqDocs[key].isVerified == false &&
              (!('verificationStatus' in reqDocs[key]) || reqDocs[key].verificationStatus != 'approved')) ||
             (resDocs is map && key in resDocs && reqDocs[key] == resDocs[key]);
    }

    function ownerDoesNotSelfVerify() {
      return !('vehicleInfo' in request.resource.data) ||
             !(request.resource.data.vehicleInfo is map) ||
             !('documents' in request.resource.data.vehicleInfo) ||
             !(request.resource.data.vehicleInfo.documents is map) ||
             (docIsUnverifiedOrUnchanged(
                request.resource.data.vehicleInfo.documents,
                ('vehicleInfo' in resource.data && resource.data.vehicleInfo is map && 'documents' in resource.data.vehicleInfo)
                  ? resource.data.vehicleInfo.documents : null,
                'insurance') &&
              docIsUnverifiedOrUnchanged(
                request.resource.data.vehicleInfo.documents,
                ('vehicleInfo' in resource.data && resource.data.vehicleInfo is map && 'documents' in resource.data.vehicleInfo)
                  ? resource.data.vehicleInfo.documents : null,
                'driverLicense') &&
              docIsUnverifiedOrUnchanged(
                request.resource.data.vehicleInfo.documents,
                ('vehicleInfo' in resource.data && resource.data.vehicleInfo is map && 'documents' in resource.data.vehicleInfo)
                  ? resource.data.vehicleInfo.documents : null,
                'vehicleRegistration') &&
              docIsUnverifiedOrUnchanged(
                request.resource.data.vehicleInfo.documents,
                ('vehicleInfo' in resource.data && resource.data.vehicleInfo is map && 'documents' in resource.data.vehicleInfo)
                  ? resource.data.vehicleInfo.documents : null,
                'technicalInspection'));
    }

    // Правила для пользователей
    match /users/{userId} {
      allow create: if isSignedIn() &&
                      request.auth.uid == userId &&
                      request.resource.data.userType in ['client', 'driver'];

      // Личные данные и документы водителя (ИИН, VIN и т.д.) доступны только владельцу и админу
      allow read: if isSignedIn() &&
                    (request.auth.uid == userId || isAdmin());

      // Владелец не может менять роль или подтверждать свои документы.
      // Администратор может проверять документы, не меняя роль профиля.
      allow update: if isSignedIn() &&
                      ((request.auth.uid == userId &&
                        request.resource.data.userType == resource.data.userType &&
                        ownerDoesNotSelfVerify()) ||
                       (isAdmin() &&
                        request.resource.data.userType == resource.data.userType));

      allow delete: if isSignedIn() && request.auth.uid == userId;
    }

    // Правила для заказов
    match /orders/{orderId} {
      function isOrderClient() {
        return isSignedIn() && resource.data.clientId == request.auth.uid;
      }

      function isOrderDriver() {
        return isSignedIn() && resource.data.driverId == request.auth.uid;
      }

      function isUnassigned() {
        return !('driverId' in resource.data) || resource.data.driverId == null;
      }

      function isUnassignedOnCreate() {
        return !('driverId' in request.resource.data) || request.resource.data.driverId == null;
      }

      allow create: if isSignedIn() &&
                      request.resource.data.clientId == request.auth.uid &&
                      request.resource.data.status == 'accepted' &&
                      isUnassignedOnCreate() &&
                      request.resource.data.weight > 0 &&
                      request.resource.data.price >= 0;

      allow read: if isOrderClient() ||
                    isOrderDriver() ||
                    isAdmin() ||
                    (isDriver() && isUnassigned());

      // Верифицированный водитель принимает доступный заказ
      allow update: if (isVerifiedDriver() &&
                        isUnassigned() &&
                        resource.data.status == 'accepted' &&
                        request.resource.data.driverId == request.auth.uid &&
                        request.resource.data.status == 'inTransit' &&
                        request.resource.data.diff(resource.data).affectedKeys()
                          .hasOnly(['driverId', 'driverName', 'driverPhone', 'status', 'statusHistory', 'acceptedAt', 'updatedAt'])) ||
                       // Назначенный водитель обновляет статус и геолокацию
                       (isOrderDriver() &&
                        request.resource.data.diff(resource.data).affectedKeys()
                          .hasOnly(['status', 'deliveredAt', 'statusHistory', 'driverLocation', 'updatedAt'])) ||
                       // Клиент отменяет свой ещё не принятый заказ
                       (isOrderClient() &&
                        isUnassigned() &&
                        resource.data.status == 'accepted' &&
                        request.resource.data.status == 'cancelled' &&
                        request.resource.data.diff(resource.data).affectedKeys()
                          .hasOnly(['status', 'cancelledAt', 'statusHistory', 'updatedAt'])) ||
                       // Администратор может управлять заказами
                       isAdmin();

      allow delete: if isOrderClient() && isUnassigned();
    }

    // Отзывы о доставке
    match /reviews/{reviewId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() &&
                      request.resource.data.clientId == request.auth.uid &&
                      request.resource.data.rating is int &&
                      request.resource.data.rating >= 1 &&
                      request.resource.data.rating <= 5;
    }

    // Отделения и тарифы
    match /offices/{officeId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /tariffs/{tariffId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Уведомления
    match /notifications/{notificationId} {
      allow read, update, delete: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isAdmin();
    }
  }
}
